<Project>

  <!--
    Central Package Management: every NuGet version for the backend lives here.
    Project files reference packages without a Version attribute.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core / EF Core">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <PackageVersion Include="Sentry.AspNetCore" Version="6.8.0" />
  </ItemGroup>

  <!--
    The SMTP client (docs/adr/0026-mail-and-password-reset.md). The framework's
    own System.Net.Mail.SmtpClient is the alternative, and Microsoft's
    documentation advises against it for new code.
  -->
  <ItemGroup Label="Mail">
    <PackageVersion Include="MailKit" Version="4.18.0" />
  </ItemGroup>

  <!--
    Transitive pins that only exist to pull known-vulnerable dependencies up to
    a patched version. Remove an entry as soon as the direct dependency ships a
    version that already references something safe.
      System.Security.Cryptography.Pkcs <= 10.0.12 GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7
        (via MailKit -> MimeKit, which still asks for 10.0.0 in 4.18.1)

    Microsoft.OpenApi (GHSA-v5pm-xwqc-g5wc) and SQLitePCLRaw.lib.e_sqlite3
    (GHSA-2m69-gcr7-jv3q) were pinned here until the 10.0.13 servicing release:
    Microsoft.AspNetCore.OpenApi and EF Core Sqlite now ask for 2.12.2 and
    2.1.13 themselves, and a pin below that is a downgrade NuGet refuses.
  -->
  <ItemGroup Label="Security pins">
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="coverlet.msbuild" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- The live connection is tested from the other end, the way a client
         speaks to it; the server half is part of ASP.NET Core itself. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
