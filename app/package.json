{
  "name": "@q2/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kudos (q2) web frontend — Nuxt 4 + Nuxt UI.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "icons": "bun scripts/generate-icons.ts",
    "typecheck": "nuxt typecheck && tsc --noEmit --project service-worker",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:coverage": "vitest run --coverage",
    "test:sentry": "vitest run --project unit sentry",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@nuxt/ui": "4.10.0",
    "@sentry/nuxt": "10.69.0",
    "nuxt": "4.5.1",
    "tailwindcss": "4.3.3",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@iconify-json/lucide": "1.2.120",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "1.62.0",
    "@vite-pwa/nuxt": "1.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "9.39.5",
    "happy-dom": "20.11.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
