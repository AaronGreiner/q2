# ---------------------------------------------------------------------------
# q2 backend (ASP.NET Core) — PLACEHOLDERS ONLY. Copy to api/.env and adjust.
#
# The .NET host does not read .env files itself. The root scripts
# (`bun run dev`, `bun run db:*`, …) read this file and pass the values on as
# real environment variables. Anything already set in your shell wins.
#
# Double underscore is the separator for nested configuration:
# `ConnectionStrings__Database` is `ConnectionStrings:Database`.
# ---------------------------------------------------------------------------

# --- Environment -------------------------------------------------------------
# Development | ManualTesting | AutomatedTest | E2E | Staging | Production
# The root scripts set this per task; only override it deliberately.
ASPNETCORE_ENVIRONMENT=Development

# --- Database ----------------------------------------------------------------
# A relative Data Source is resolved against api/.data, never against the
# process working directory. Leave empty to use the environment's default
# (api/.data/q2-development.db in Development).
ConnectionStrings__Database=

# Overrides the directory relative paths resolve against.
Q2_DATA_DIR=

# --- Sentry ------------------------------------------------------------------
# DSN of the q2-api Sentry project. Empty means the SDK initialises but sends
# nothing, and the application logs that once at startup.
# Never use a production DSN locally.
Sentry__Dsn=

# Leave empty to derive it from ASPNETCORE_ENVIRONMENT
# (Development -> local-development, E2E -> e2e, …).
Sentry__Environment=

# Shared with the frontend so both correlate: q2@<version-or-commit>.
# Empty derives it from GIT_COMMIT_SHA or the assembly version.
Sentry__Release=

# Empty = enabled whenever a DSN is present. `true` without a DSN fails at
# startup with a readable message.
Sentry__Enabled=

# SDK diagnostic output. Noisy; only useful when debugging the integration.
Sentry__Debug=false

# Share of error events kept. 1.0 everywhere — errors are never sampled away.
Sentry__SampleRate=1.0

# Share of transactions traced. 1.0 locally and in tests, lower in production.
Sentry__TracesSampleRate=1.0

# Structured warnings/errors and anonymous operational counters. Both are on
# by default; spell them out here so an environment override is discoverable.
Sentry__EnableLogs=true
Sentry__EnableMetrics=true

# `recording` swaps the transport for a local, network-free recorder.
# Refused in Staging and Production. Set by the test harness, not by hand.
SENTRY_TEST_TRANSPORT=
SENTRY_TEST_TRANSPORT_FILE=

# --- Release correlation -----------------------------------------------------
Q2_RELEASE=
GIT_COMMIT_SHA=
CI_RUN_ID=

# --- Test harness ------------------------------------------------------------
TEST_RUN_ID=
TEST_SEED_PROFILE=

# --- Symbol / source upload (BUILD TIME / CI ONLY) ---------------------------
# Read as MSBuild properties by Q2.Api.csproj, which uploads the debug symbols
# and sources so a .NET stack trace in Sentry has line numbers.
#
# Leave empty locally. Both uploads are skipped without an auth token, so the
# build behaves exactly as before — sentry-cli is not invoked at all.
SENTRY_ORG=
SENTRY_PROJECT_API=q2-api
SENTRY_AUTH_TOKEN=
