# ---------------------------------------------------------------------------
# q2 — repository-level environment defaults (PLACEHOLDERS ONLY).
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never contain real
# production secrets.
#
# Scope of this file:
#   * read by Bun when you run any root script (`bun run dev`, `bun run test`, …)
#   * forwarded to the ASP.NET Core process started by those scripts
#
# The two sub-projects have their own files with the full list of settings:
#   * api/.env.example  — backend (ASP.NET Core) settings
#   * app/.env.example  — frontend (Nuxt) settings; loaded by Nuxt itself
# ---------------------------------------------------------------------------

# --- Release correlation ----------------------------------------------------
# One release id shared by frontend and backend, so Sentry can correlate them.
# Leave empty locally: the app derives `q2@<git-sha>` (or `q2@dev`) itself.
Q2_RELEASE=

# Populated automatically by CI. Used for Sentry release + event tags.
GIT_COMMIT_SHA=
CI_RUN_ID=

# --- Test harness -----------------------------------------------------------
# Identifies one test run; tagged onto Sentry events produced by tests.
TEST_RUN_ID=
# Which seed profile a manually started test environment should use.
# One of: Development | ManualTesting | AutomatedTest | E2E
TEST_SEED_PROFILE=
# Absolute or repo-relative path of the SQLite file used by a test run.
TEST_DATABASE_PATH=
# `recording` swaps the Sentry transport for a local, network-free recorder.
# Anything else keeps the real HTTP transport. Never set this in production.
SENTRY_TEST_TRANSPORT=
# Where the recording transport writes captured events (JSON Lines).
SENTRY_TEST_TRANSPORT_FILE=
# Syntactically valid but non-routable DSN used by tests. NOT a real project.
SENTRY_TEST_DSN=https://0000000000000000000000000000000@localhost/0

# --- Symbol / source upload (CI secrets only) -------------------------------
# Never commit a real value and never expose these to the browser bundle.
#
# Both halves upload, into their own Sentry project, which is why there are two
# project slugs:
#   * the frontend uploads source maps  (app/nuxt.config.ts)
#   * the backend uploads debug symbols and sources (api/src/Q2.Api/Q2.Api.csproj,
#     via the Sentry MSBuild targets — MSBuild reads these as properties)
# Without them a stack trace in Sentry has no line numbers and no source.
#
# Needed by the release workflow, not by local development: with no auth token
# both uploads are skipped and the builds succeed unchanged.
SENTRY_ORG=
SENTRY_PROJECT_APP=q2-app
SENTRY_PROJECT_API=q2-api
SENTRY_AUTH_TOKEN=
