{
  "// Purpose": "Production. No automatic migration, no seeding, no reset — ever.",
  "// ConnectionStrings": "Must be supplied via ConnectionStrings__Database.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false,
    "ResetOnStartup": false,
    "SeedProfile": "None",
    "AllowDestructiveReset": false
  },
  "Sentry": {
    "SampleRate": 1.0,
    "TracesSampleRate": 0.1
  }
}
