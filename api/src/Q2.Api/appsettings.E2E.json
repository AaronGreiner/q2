{
  "// Purpose": "End-to-end runs. Playwright creates a uniquely named temporary SQLite file, migrates and seeds it before the server starts, and deletes it afterwards.",
  "ConnectionStrings": {
    "Database": "Data Source=q2-e2e.db"
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": false,
    "ResetOnStartup": false,
    "SeedProfile": "E2E",
    "AllowDestructiveReset": true
  },
  "Sentry": {
    "SampleRate": 1.0,
    "TracesSampleRate": 1.0
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}
