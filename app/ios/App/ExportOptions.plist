<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  How `bun run app:ios:testflight` (scripts/ios.ts) exports the archive:
  signed for App Store Connect with the team the project names, and uploaded
  straight to it, which is what makes the build appear in TestFlight.

  Version and build number are set by the script and must stay as they are,
  hence manageAppVersionAndBuildNumber = false.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
