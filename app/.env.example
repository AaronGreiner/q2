# ---------------------------------------------------------------------------
# q2 frontend (Nuxt) — PLACEHOLDERS ONLY. Copy to app/.env and adjust.
#
# Everything prefixed NUXT_PUBLIC_ is compiled into the browser bundle and is
# therefore public. Never put a secret behind that prefix.
# ---------------------------------------------------------------------------

# --- API ---------------------------------------------------------------------
# Where the ASP.NET Core API is reachable from the browser.
NUXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Which environment the UI believes it is in. Shown in the header outside
# production so a screenshot is never ambiguous.
# local-development | manual-testing | e2e | staging | production
NUXT_PUBLIC_APP_ENV=local-development

# Enables /diagnostics, the page that deliberately triggers errors.
# Must stay false in production.
NUXT_PUBLIC_DIAGNOSTICS_ENABLED=true

# --- Sentry (client + Nuxt server) -------------------------------------------
# Public DSN of the q2-app Sentry project. Public by design — a DSN only allows
# sending events. Leave empty to run without error reporting.
NUXT_PUBLIC_SENTRY_DSN=

# Leave empty to derive it from NUXT_PUBLIC_APP_ENV. Set it only to override.
NUXT_PUBLIC_SENTRY_ENVIRONMENT=

# Shared with the backend so both services correlate: q2@<version-or-commit>.
NUXT_PUBLIC_SENTRY_RELEASE=

# Empty = enabled whenever a DSN is present. `true` without a DSN fails loudly.
NUXT_PUBLIC_SENTRY_ENABLED=

# 1 locally and in tests, lower in production. See docs/observability.md.
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1

# --- Source map upload (BUILD TIME / CI ONLY) --------------------------------
# Not prefixed NUXT_PUBLIC_ on purpose: these must never reach the browser.
# Leave empty locally; the build skips the upload when the token is absent.
SENTRY_ORG=
SENTRY_PROJECT_APP=q2-app
SENTRY_AUTH_TOKEN=
