{
  "// Purpose": "Production-like. Nothing here touches the database automatically; migrations are a deliberate deployment step.",
  "// ConnectionStrings": "Must be supplied via ConnectionStrings__Database.",
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false,
    "ResetOnStartup": false,
    "SeedProfile": "None",
    "AllowDestructiveReset": false
  },
  "Sentry": {
    "SampleRate": 1.0,
    "TracesSampleRate": 0.5
  }
}
