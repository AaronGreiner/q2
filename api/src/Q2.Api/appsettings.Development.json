{
  "// Purpose": "Normal local development. The database is persistent and is never dropped automatically.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Q2.Api": "Debug"
    }
  },
  "Urls": "http://localhost:5080",
  "ConnectionStrings": {
    "Database": "Data Source=q2-development.db"
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedOnStartup": true,
    "ResetOnStartup": false,
    "SeedProfile": "Development",
    "AllowDestructiveReset": false
  },
  "Sentry": {
    "TracesSampleRate": 1.0
  },
  "Q2": {
    "PublicAppUrl": "http://localhost:3000",
    "// Mail": "Nothing is sent: every mail becomes a .eml under api/.data/mail, which any mail client opens. The API logs where it wrote each one.",
    "Mail": {
      "Transport": "File",
      "From": "noreply@q2.invalid"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}
