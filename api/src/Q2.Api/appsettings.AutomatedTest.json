{
  "// Purpose": "Automated API tests. The test host overrides the connection string with a private SQLite in-memory database per test class; this file only supplies the defaults.",
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "ConnectionStrings": {
    "Database": "Data Source=q2-automated-test;Mode=Memory;Cache=Shared"
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false,
    "ResetOnStartup": false,
    "SeedProfile": "AutomatedTest",
    "AllowDestructiveReset": true
  },
  "Sentry": {
    "TestTransport": "recording",
    "SampleRate": 1.0,
    "TracesSampleRate": 1.0
  }
}
