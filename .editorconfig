root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csproj,sln,props,targets}]
indent_size = 4

# ---------------------------------------------------------------------------
# C# style — enforced by `dotnet format` (see `bun run format:check`).
# Keep this list small and uncontroversial; it exists so that formatting is
# never a review topic.
# ---------------------------------------------------------------------------
[*.cs]
# Namespaces
csharp_style_namespace_declarations = file_scoped:error

# `var` usage — explicit types where the type is not obvious from the RHS.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern C# expression styles
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_using_directive_placement = outside_namespace:error

# Usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Naming: private constants and private static readonly fields are PascalCase,
# private instance fields are _camelCase. The two PascalCase groups are more
# specific than the catch-all, so they win for `const` / `static readonly`.
dotnet_naming_rule.private_constants_pascal.severity = warning
dotnet_naming_rule.private_constants_pascal.symbols = private_constants
dotnet_naming_rule.private_constants_pascal.style = pascal_case_style
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const

dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_case_style
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static,readonly

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefixed
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.underscore_prefixed.required_prefix = _
dotnet_naming_style.underscore_prefixed.capitalization = camel_case

# Analyzer noise we do not want to fail the build on.
dotnet_diagnostic.CA1848.severity = none  # LoggerMessage delegates — overkill here
dotnet_diagnostic.CA2007.severity = none  # ConfigureAwait — not needed in ASP.NET Core

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2
