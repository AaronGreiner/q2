  "components": {
    "schemas": {
      "ActivityKind": {
        "enum": [
          "TaskCompleted",
          "StreakReached",
          "GoalProgress",
          "GoalCreated"
        ]
      },
      "ActivityResponse": {
        "required": [
          "id",
          "actor",
          "kind",
          "subject",
          "amount",
          "kudosCount",
          "hasMyKudos",
          "occurredAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "actor": {
            "$ref": "#/components/schemas/PersonSummary"
          },
          "kind": {
            "$ref": "#/components/schemas/ActivityKind"
          },
          "subject": {
            "type": "string",
            "nullable": true
          },
          "amount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "kudosCount": {
            "type": "integer",
            "format": "int32"
          },
          "hasMyKudos": {
            "type": "boolean"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BadgeKey": {
        "enum": [
          "StreakHero",
          "EarlyBird",
          "Bookworm",
          "KudosGiver",
          "Marathon",
          "WeeklyWinner"
        ]
      },
      "BadgeResponse": {
        "required": [
          "key",
          "isEarned",
          "earnedOn"
        ],
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/components/schemas/BadgeKey"
          },
          "isEarned": {
            "type": "boolean"
          },
          "earnedOn": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "ChatDetailResponse": {
        "required": [
          "id",
          "kind",
          "name",
          "initials",
          "avatarColor",
          "isOnline",
          "memberCount",
          "otherLastSeenAt",
          "pinnedGoal",
          "messages"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/ConversationKind"
          },
          "name": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "avatarColor": {
            "type": "string"
          },
          "isOnline": {
            "type": "boolean"
          },
          "memberCount": {
            "type": "integer",
            "format": "int32"
          },
          "otherLastSeenAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "pinnedGoal": {
            "oneOf": [
              {
                "enum": [
                  null
                ]
              },
              {
                "$ref": "#/components/schemas/ChatPinnedGoalResponse"
              }
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessageResponse"
            }
          }
        }
      },
      "ChatMessageResponse": {
        "required": [
          "id",
          "senderId",
          "senderName",
          "text",
          "isMine",
          "sentAt",
          "reactions"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "senderId": {
            "type": "string",
            "format": "uuid"
          },
          "senderName": {
            "type": "string",
            "nullable": true
          },
          "text": {
            "type": "string"
          },
          "isMine": {
            "type": "boolean"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          },
          "reactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageReactionResponse"
            }
          }
        }
      },
      "ChatPinnedGoalResponse": {
        "required": [
          "id",
          "title",
          "progressPercent"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "progressPercent": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ChatSummaryResponse": {
        "required": [
          "id",
          "kind",
          "name",
          "initials",
          "avatarColor",
          "isOnline",
          "lastMessage",
          "lastMessageSenderName",
          "lastMessageIsMine",
          "lastMessageAt",
          "unreadCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/ConversationKind"
          },
          "name": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "avatarColor": {
            "type": "string"
          },
          "isOnline": {
            "type": "boolean"
          },
          "lastMessage": {
            "type": "string",
            "nullable": true
          },
          "lastMessageSenderName": {
            "type": "string",
            "nullable": true
          },
          "lastMessageIsMine": {
            "type": "boolean"
          },
          "lastMessageAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "unreadCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ConversationKind": {
        "enum": [
          "Direct",
          "Group"
        ]
      },
      "CreateGoalRequest": {
        "type": "object",
        "properties": {
